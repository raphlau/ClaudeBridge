{
  "listen_port": 8765,
  "public_url": "https://your-pc.your-tailnet.ts.net",
  "token": "generated-by-install.ps1-at-least-32-characters-long",
  "roots": [
    { "name": "Backups", "path": "D:\\MEGA\\Important Documents", "mode": "write", "sync_app": "MEGA" },
    { "name": "Notes", "path": "C:\\Users\\you\\Documents\\Obsidian\\Vault", "mode": "write", "sync_app": "Obsidian" }
  ],
  "sync_apps": [
    { "name": "MEGA", "process": "MEGAsync.exe", "launch": ["C:\\Users\\you\\AppData\\Local\\MEGAsync\\MEGAsync.exe"] },
    { "name": "Obsidian", "process": "Obsidian.exe", "launch": "obsidian://open?vault=Vault", "vault": "C:\\Users\\you\\Documents\\Obsidian\\Vault" }
  ],
  "history_days": 30,
  "deny_folders": [".git", ".obsidian", ".ssh", ".gnupg", ".debris", "$recycle.bin"],
  "deny_files": ["*.kdbx", "*.kdb", ".env", "*.pem", "*.key", "id_rsa*", "id_ed25519*"],
  "claude_app": {
    "launch": ["explorer.exe", "shell:AppsFolder\\<AppID from Get-StartApps>"],
    "exe_match": ["\\windowsapps\\claude_", "\\anthropicclaude\\", "\\programs\\claude\\"]
  },
  "limits": { "max_upload_mb": 500, "link_minutes": 15 },
  "quiet": true
}
